{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sixiang-world/qqmail-cli/schemas/config.validate.schema.json",
  "allOf": [
    {
      "$ref": "envelope-common.schema.json"
    },
    {
      "properties": {
        "command": {
          "const": "config.validate"
        }
      },
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/validationReport"
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "type": "object",
            "properties": {
              "context": {
                "type": "object",
                "properties": {
                  "config_path": {
                    "type": "string"
                  },
                  "exists": {
                    "type": "boolean"
                  },
                  "valid": {
                    "type": "boolean"
                  },
                  "diagnostics": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/diagnostic"
                    }
                  },
                  "summary": {
                    "$ref": "#/$defs/summary"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "diagnostic": {
      "type": "object",
      "required": [
        "severity",
        "code",
        "path",
        "message"
      ],
      "properties": {
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "errors",
        "warnings",
        "info"
      ],
      "properties": {
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "validationReport": {
      "type": "object",
      "required": [
        "config_path",
        "exists",
        "valid",
        "diagnostics",
        "summary"
      ],
      "properties": {
        "config_path": {
          "type": "string"
        },
        "exists": {
          "type": "boolean"
        },
        "valid": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "summary": {
          "$ref": "#/$defs/summary"
        }
      },
      "additionalProperties": false
    }
  }
}
