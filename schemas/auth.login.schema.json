{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sixiang-world/qqmail-cli/schemas/auth.login.schema.json",
  "allOf": [
    {
      "$ref": "envelope-common.schema.json"
    },
    {
      "properties": {
        "command": {
          "const": "auth.login"
        }
      },
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "name",
              "email",
              "server",
              "credential_source",
              "verified"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "server": {
                "type": "string"
              },
              "credential_source": {
                "type": "string"
              },
              "verified": {
                "type": "boolean"
              },
              "imap_verified": {
                "type": "boolean"
              },
              "smtp_checked": {
                "type": "boolean"
              },
              "smtp_verified": {
                "type": "boolean"
              },
              "smtp_server": {
                "type": "string"
              },
              "smtp_endpoint": {
                "type": "string"
              },
              "smtp_transport": {
                "type": "string",
                "enum": [
                  "implicit_tls",
                  "starttls"
                ]
              },
              "smtp_fallback_used": {
                "type": "boolean"
              },
              "smtp_extensions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "type": "object",
            "properties": {
              "context": {
                "type": "object",
                "properties": {
                  "stage": {
                    "type": "string"
                  },
                  "imap_verified": {
                    "type": "boolean"
                  },
                  "smtp_checked": {
                    "type": "boolean"
                  },
                  "smtp_verified": {
                    "type": "boolean"
                  },
                  "smtp_server": {
                    "type": "string"
                  },
                  "credential_saved": {
                    "type": "boolean"
                  },
                  "credential_save_state": {
                    "enum": [
                      "failed",
                      "uncertain"
                    ]
                  },
                  "outcome_uncertain": {
                    "type": "boolean"
                  },
                  "credential_cleanup_ok": {
                    "type": "boolean"
                  },
                  "config_saved": {
                    "type": "boolean"
                  },
                  "credential_store": {
                    "type": "string"
                  },
                  "reason": {
                    "enum": [
                      "no_session_bus",
                      "service_unavailable",
                      "locked",
                      "permission_denied",
                      "timeout",
                      "unknown"
                    ]
                  },
                  "platform": {
                    "type": "string"
                  },
                  "dbus_session_bus_set": {
                    "type": "boolean"
                  },
                  "observed": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
